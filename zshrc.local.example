# ============================================================================
# Local Zsh Configuration - Machine-Specific Settings
# ============================================================================
# 
# INSTRUCTIONS:
# 1. Copy this file to ~/.zshrc.local
# 2. Fill in your API keys and machine-specific settings
# 3. NEVER commit ~/.zshrc.local to git (it's in .gitignore)
# 4. Secure the file: chmod 600 ~/.zshrc.local
#
# This file is automatically sourced by ~/.zshrc at the end of initialization.
# Use it for secrets, API keys, and settings that vary between machines.
#
# ============================================================================

# ----------------------------------------------------------------------------
# API KEYS - Add your keys here
# ----------------------------------------------------------------------------

# NanoBanana API
# export NANOBANANA_API_KEY="your_key_here"

# Groq API
# export GROQ_API_KEY="your_key_here"

# OpenAI API (if needed)
# export OPENAI_API_KEY="your_key_here"

# Anthropic Claude API (if needed)  
# export ANTHROPIC_API_KEY="your_key_here"

# ----------------------------------------------------------------------------
# AI TOOL SETTINGS
# ----------------------------------------------------------------------------

# Claude Code settings
# export CLAUDE_CODE_MAX_OUTPUT_TOKENS=8192

# ----------------------------------------------------------------------------
# SSH KEYCHAIN (override default key if needed)
# ----------------------------------------------------------------------------

# Uncomment to use a different SSH key with keychain
# export SSH_KEY_PATH="$HOME/.ssh/id_rsa"

# ----------------------------------------------------------------------------
# MACHINE-SPECIFIC PATHS
# ----------------------------------------------------------------------------

# Add custom paths that only exist on this machine
# export PATH="/custom/path/bin:$PATH"

# ----------------------------------------------------------------------------
# WORK-SPECIFIC ALIASES
# ----------------------------------------------------------------------------

# Add aliases that only make sense on this machine
# alias work-server='ssh user@work-server.example.com'
# alias work-vpn='sudo openconnect vpn.company.com'

# ----------------------------------------------------------------------------
# DEVELOPMENT SETTINGS
# ----------------------------------------------------------------------------

# Python virtualenvwrapper location (if varies by machine)
# export WORKON_HOME="$HOME/.virtualenvs"

# Node/npm settings
# export NPM_TOKEN="your_npm_token"

# ----------------------------------------------------------------------------
# CLOUD PROVIDER CREDENTIALS
# ----------------------------------------------------------------------------

# AWS (if not using ~/.aws/credentials)
# export AWS_ACCESS_KEY_ID=""
# export AWS_SECRET_ACCESS_KEY=""

# Google Cloud
# export GOOGLE_APPLICATION_CREDENTIALS="$HOME/.config/gcloud/key.json"

# Azure
# export AZURE_SUBSCRIPTION_ID=""

# ============================================================================
# SECURITY REMINDER
# ============================================================================
# After editing this file, run:
#   chmod 600 ~/.zshrc.local
#
# This ensures only you can read the file (contains secrets!)
# ============================================================================
